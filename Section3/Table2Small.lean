import ExactAnalytic

/-!
# Table 2, rows `n = 1, 2, 3`

The largest excess `t_{n,m}(G) - C(m)` over `2 ≤ m ≤ 2^n`, the `m` where it is attained,
and, for `n ≥ 3`, that this `m` is unique. Generated by `ci/generate_exact.py`.
-/

noncomputable section

namespace GradientKey.Concrete

/-- Table 2, `n = 1`: `t_{1,m}(G) - C(m) ≤ 0` for `2 ≤ m ≤ 2^1`. -/
theorem table2_n1_bound (m : ℕ) (hm : 2 ≤ m) (hs : m ≤ 2 ^ 1) :
    tG 1 m (by norm_num) - completeCost m ≤ (0 : ℝ) / 1 := by
  norm_num at hs
  interval_cases m
  · rw [exact_n1_m2, completeCost_val_2]
    norm_num

/-- Table 2, `n = 1`: the maximum `0` is attained at `m = 2`. -/
theorem table2_n1_attained :
    tG 1 2 (by norm_num) - completeCost 2 = (0 : ℝ) / 1 := by
  rw [exact_n1_m2, completeCost_val_2]
  norm_num

