/-- Table 2, `n = 3`: `t_{3,m}(G) - C(m) ≤ 1/35` for `2 ≤ m ≤ 2^3`. -/
theorem table2_n3_bound (m : ℕ) (hm : 2 ≤ m) (hs : m ≤ 2 ^ 3) :
    tG 3 m (by norm_num) - completeCost m ≤ (1 : ℝ) / 35 := by
  norm_num at hs
